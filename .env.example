# Copy to `.env.local` to point the dashboard at the real detection engine.
# Leave unset (or delete the file) to run on the mock data layer.
#
# The dashboard expects:
#   GET  {VITE_SOC_API_URL}/api/events?since=<epoch_ms>
#   WS   {VITE_SOC_API_URL}/ws/events
#
# See src/data/providers/UbuntuSecurityEventProvider.ts for the payload shape.
#
# VITE_ vars are inlined at build time. After editing, restart `npm run dev`.

# Base URL of the SOC backend running on the Ubuntu victim.
VITE_SOC_API_URL=http://10.139.116.20:8000

# The victim's own IP, so it is excluded from "Top Attack Sources". Must equal
# the backend's SOC_VICTIM_IP exactly.
VITE_SOC_VICTIM_IP=10.139.116.20

# URL of the companion ThreatPulse-AI app, opened from the sidebar link.
# Defaults to this production URL when unset; override for another environment.
VITE_THREATPULSE_URL=https://threatpulse.up.railway.app/
