# SOC detection engine configuration.
# Install to /etc/soc-engine/soc-engine.env

# --- Identity ---------------------------------------------------------------
# MUST match HOST_IDS.victim in src/data/topology.ts. Events reference this id,
# and the dashboard header hardcodes it for the "Ubuntu Victim: ONLINE" light.
SOC_VICTIM_HOST_ID=ubuntu-victim

# MUST match VICTIM_IP in src/data/topology.ts. The dashboard excludes this
# exact string from "Top Attack Sources"; a mismatch makes the monitored host
# rank as its own attacker.
SOC_VICTIM_IP=192.168.56.105

# Display name in the host table. Leave unset to use the machine's real
# hostname, which is the honest default.
#SOC_VICTIM_HOSTNAME=ubuntu-victim

# --- Log sources ------------------------------------------------------------
SOC_AUTH_LOG=/var/log/auth.log
SOC_KERN_LOG=/var/log/kern.log

# Port-scan detection via [UFW BLOCK] records. Requires `sudo ufw logging on`.
# The collector disables itself cleanly if kern.log is unreadable.
SOC_ENABLE_UFW=true

# Inbound connection observation via socket-table sampling. Low value and a
# little noisy on a busy host; set false to silence it.
SOC_ENABLE_NEW_CONNECTION=true

# --- Detection thresholds ---------------------------------------------------
# 5 failures within 60s fires one critical alert, then 300s of quiet per source
# so a long hydra run produces a handful of alerts rather than hundreds.
SOC_BF_WINDOW_S=60
SOC_BF_THRESHOLD=5
SOC_BF_COOLDOWN_S=300

# 10 DISTINCT ports within 60s. Distinct-port counting is what separates a
# sweep from a client retrying one closed port.
SOC_PS_WINDOW_S=60
SOC_PS_THRESHOLD=10
SOC_PS_COOLDOWN_S=300

# A login succeeding within 900s of 3+ failures from the same source is
# escalated to high — what a successful brute force looks like.
SOC_LOGIN_ESCALATION_S=900
SOC_LOGIN_ESCALATION_FAILS=3

# --- Timing -----------------------------------------------------------------
SOC_TAIL_POLL_S=0.5
SOC_TELEMETRY_INTERVAL_S=5
SOC_BACKFILL_WINDOW_S=86400

# --- WebSocket --------------------------------------------------------------
# Replays recent events when a dropped socket reconnects, closing the gap where
# events are otherwise lost. Safe because the dashboard dedupes by event id.
# Set to 0 if you are running an older frontend without that dedupe.
SOC_WS_REPLAY_SECONDS=120
SOC_WS_REPLAY_MAX=200

# --- CORS -------------------------------------------------------------------
# Must allow the origin the dashboard is served from. Vite uses strictPort:false
# so the port may increment past 5173. Missing CORS is the most common first-run
# failure, and it presents as "the WebSocket never connects".
SOC_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3})(:\d+)?
